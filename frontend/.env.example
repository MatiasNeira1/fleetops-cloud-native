# Desarrollo local con proxy de Vite:
# Deja VITE_API_BASE_URL vacio y el frontend llamara /api/*.
# Vite redirige esas llamadas al backend local configurado en vite.config.ts.
VITE_API_BASE_URL=

# Desarrollo local llamando directo al backend:
# VITE_API_BASE_URL=http://localhost:8080

# Produccion:
# Usa la URL HTTPS publica real del backend o APIM. No guardar secretos en VITE_*.
# VITE_API_BASE_URL=https://mi-apim.azure-api.net/fleetops
