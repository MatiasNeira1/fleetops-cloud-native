# Normalizar archivos de texto
* text=auto

# Código y configuración
*.java text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.properties text eol=lf

*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

*.yml text eol=lf
*.yaml text eol=lf

*.tf text eol=lf
*.tfvars text eol=lf

*.sh text eol=lf
Dockerfile text eol=lf

*.md text eol=lf

# Scripts Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
