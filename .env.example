# FleetOps - variables de entorno de ejemplo
#
# Este archivo se versiona para documentar la configuracion esperada.
# No incluyas secretos reales, credenciales, tokens ni cadenas de conexion productivas.
#
# LOCAL puede usar valores locales, contenedores Docker o emuladores cuando existan.
# DEV y DEMO usaran configuracion externa administrada en Azure.
# En Azure se priorizara Managed Identity + Azure Key Vault por sobre secretos en archivos.

APP_ENV=local

# PostgreSQL local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=change_me

# Puerto publicado por el contenedor PostgreSQL en LOCAL
POSTGRES_CONTAINER_PORT=5432

# Azure Event Hubs
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=telemetria-vehiculos

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_TOPIC=eventos-fleetops

# Azure Web PubSub
AZURE_WEB_PUBSUB_CONNECTION_STRING=

# Azure Monitor / Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
