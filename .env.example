
APP_ENV=local

# PostgreSQL local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=change_me

# Puerto publicado por el contenedor PostgreSQL en LOCAL
POSTGRES_CONTAINER_PORT=5432

# Azure Event Hubs
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=telemetria-vehiculos

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_TOPIC=eventos-fleetops

# Azure Web PubSub
AZURE_WEB_PUBSUB_CONNECTION_STRING=

# Azure Monitor / Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=


# RabbitMQ local
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fleetops
RABBITMQ_PASSWORD=change_me

RABBITMQ_CONTAINER_PORT=5672
RABBITMQ_MANAGEMENT_CONTAINER_PORT=15672
