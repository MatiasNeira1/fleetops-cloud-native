
APP_ENV=local

# PostgreSQL local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=change_me

# Puerto publicado por el contenedor PostgreSQL en LOCAL
POSTGRES_CONTAINER_PORT=5432

# Azure Event Hubs
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=telemetria-vehiculos

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_TOPIC=eventos-fleetops

# Azure Web PubSub
AZURE_WEB_PUBSUB_CONNECTION_STRING=

# Azure Monitor / Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=


# RabbitMQ local
# Valores ficticios para desarrollo local. Copia a .env y cambia los secretos si corresponde.
RABBITMQ_DEFAULT_USER=fleetops
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_ERLANG_COOKIE=replace_with_a_long_local_demo_cookie

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
SPRING_RABBITMQ_ADDRESSES=localhost:5672,localhost:5673
SPRING_RABBITMQ_USERNAME=fleetops
SPRING_RABBITMQ_PASSWORD=change_me

# Usar solo cuando el backend corre dentro de Docker:
# SPRING_RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672

RABBITMQ_NODE1_AMQP_PORT=5672
RABBITMQ_NODE1_MANAGEMENT_PORT=15672
RABBITMQ_NODE2_AMQP_PORT=5673
RABBITMQ_NODE2_MANAGEMENT_PORT=15673
