root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml}]
indent_size = 2

[*.tf]
indent_size = 2

[*.xml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.ps1]
indent_size = 4

[*.sh]
indent_size = 2
