# Genera un valor aleatorio de al menos 32 caracteres. No lo subas al repositorio.
MCP_CLIENT_TOKEN=
MCP_PORT=8088
MCP_BIND_ADDRESS=127.0.0.1
MCP_ALLOWED_ORIGINS=
# Secure MCP Tunnel: crea el ID en Platform y usa una runtime API key con Tunnels Read + Use.
# Estos valores son ficticios; guarda el secreto solo en .env ignorado o en el entorno del proceso.
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
CONTROL_PLANE_API_KEY=
FLEETOPS_FLOTA_API_URL=http://127.0.0.1:8080
FLEETOPS_ALERTA_API_URL=http://127.0.0.1:8081
# Solo si las API REST empiezan a exigir una credencial de servicio distinta.
FLEETOPS_FLOTA_API_BEARER_TOKEN=
FLEETOPS_ALERTA_API_BEARER_TOKEN=
FLEETOPS_API_CONNECT_TIMEOUT=3s
FLEETOPS_API_READ_TIMEOUT=10s
